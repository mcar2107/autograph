{
  "name": "autograph",
  "version": "0.4.0",
  "type": "module",
  "description": "генератор рукописного текста",
  "license": "MIT",
  "author": "corvus278",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:icons": "esbuild scripts/build-app-icons.ts --bundle --platform=node --format=esm --external:playwright --outfile=node_modules/.cache/build-app-icons.mjs --log-level=error && node node_modules/.cache/build-app-icons.mjs",
    "build:paper": "esbuild scripts/build-paper-profiles.ts --bundle --platform=node --format=esm --external:playwright --define:import.meta.env.BASE_URL='\"/\"' --outfile=node_modules/.cache/build-paper-profiles.mjs --log-level=error && node node_modules/.cache/build-paper-profiles.mjs",
    "measure:sheet": "esbuild scripts/measure-sheet.ts --bundle --platform=node --format=esm --external:playwright --define:import.meta.env.BASE_URL='\"/\"' --outfile=node_modules/.cache/measure-sheet.mjs --log-level=error && node node_modules/.cache/measure-sheet.mjs",
    "measure:margin-color": "esbuild scripts/margin-line-ground-truth.ts --bundle --platform=node --format=esm --external:playwright --define:import.meta.env.BASE_URL='\"/\"' --outfile=node_modules/.cache/margin-line-ground-truth.mjs --log-level=error && node node_modules/.cache/margin-line-ground-truth.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:pwa": "vitest run --project=pwa",
    "lint": "concurrently --kill-others-on-fail \"npm run lint:es\" \"npm run typecheck\" \"npm run lint:css\" \"npm run lint:format\" \"npm run lint:fsd\"",
    "lint:es": "eslint . --cache --cache-strategy=content",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "lint:format": "prettier --check .",
    "prepare": "husky",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "storybook": "storybook dev -p 6006",
    "test:stories": "vitest run --project=storybook",
    "build:storybook": "storybook build",
    "visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.63.0-noble bash -lc \"npm ci && npx playwright install chromium && npx vitest run --project=visual $VITEST_ARGS\"",
    "test:visual": "npm run visual:docker",
    "test:visual:update": "VITEST_ARGS=--update npm run visual:docker"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist-to-esbuild": "2.1.1",
    "concurrently": "10.0.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.0.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "65.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.4.0",
    "http-server": "^14.1.1",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.1.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.6.0",
    "storybook": "^10.6.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.57.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  }
}
